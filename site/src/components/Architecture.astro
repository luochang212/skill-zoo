---
import { useTranslations, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="sec" id="arch">
  <div class="sec-inner">
    <div class="eyebrow" data-i18n="arch-eyebrow">{t("arch-eyebrow")}</div>
    <h2 data-i18n="arch-title" data-reveal style="--r-delay: 0ms">{t("arch-title")}</h2>
    <p
      class="lead"
      data-i18n="arch-lead"
      data-reveal
      style="--r-delay: 120ms"
    >{t("arch-lead")}</p>

    <div class="stat-row">
      <div>
        <div class="stat-num">3</div>
        <div class="stat-label" data-i18n="stat-platforms">{t("stat-platforms")}</div>
      </div>
      <div>
        <div class="stat-num">2</div>
        <div class="stat-label" data-i18n="stat-langs">{t("stat-langs")}</div>
      </div>
      <div>
        <div class="stat-num">20+</div>
        <div class="stat-label" data-i18n="stat-agents">{t("stat-agents")}</div>
      </div>
      <div>
        <div class="stat-num">0</div>
        <div class="stat-label" data-i18n="stat-shell">{t("stat-shell")}</div>
      </div>
    </div>

    <div class="arch-diagram">
      <svg
        viewBox="0 0 860 320"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect
          x="30"
          y="20"
          width="230"
          height="280"
          rx="14"
          fill="#fff"
          stroke="#E2E0D9"
          stroke-width="1.5"
        />
        <text
          x="145"
          y="56"
          text-anchor="middle"
          font-family="ui-serif,Georgia,serif"
          font-size="16"
          font-weight="500"
          fill="#121215"
        >
          Frontend
        </text>
        <text
          x="145"
          y="80"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="10"
          fill="#7B7972"
        >
          React 19 · TypeScript
        </text>

        <rect
          x="50"
          y="100"
          width="190"
          height="32"
          rx="8"
          fill="#EDEBE5"
          stroke="#E2E0D9"
          stroke-width="0.8"
        />
        <text
          x="145"
          y="121"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="10"
          fill="#3D3C38"
        >
          TanStack Query
        </text>
        <rect
          x="50"
          y="140"
          width="190"
          height="32"
          rx="8"
          fill="#EDEBE5"
          stroke="#E2E0D9"
          stroke-width="0.8"
        />
        <text
          x="145"
          y="161"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="10"
          fill="#3D3C38"
        >
          shadcn/ui + Tailwind
        </text>
        <rect
          x="50"
          y="180"
          width="190"
          height="32"
          rx="8"
          fill="#EDEBE5"
          stroke="#E2E0D9"
          stroke-width="0.8"
        />
        <text
          x="145"
          y="201"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="10"
          fill="#3D3C38"
        >
          i18next · Framer Motion
        </text>

        <text
          x="145"
          y="242"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="9.5"
          fill="#7B7972"
        >
          UI state → useState
        </text>
        <text
          x="145"
          y="259"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="9.5"
          fill="#7B7972"
        >
          Server state → React Query
        </text>

        <rect
          x="316"
          y="100"
          width="228"
          height="120"
          rx="14"
          fill="rgba(197,102,59,0.04)"
          stroke="#C5663B"
          stroke-width="1.5"
          stroke-dasharray="6 4"
        >
          <animate
            attributeName="stroke-dashoffset"
            from="0"
            to="20"
            dur="1.5s"
            repeatCount="indefinite"
          />
        </rect>
        <text
          x="430"
          y="136"
          text-anchor="middle"
          font-family="ui-serif,Georgia,serif"
          font-size="16"
          font-weight="500"
          fill="#C5663B"
        >
          Tauri IPC
        </text>
        <text
          x="430"
          y="159"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="10"
          fill="#C5663B"
          opacity="0.7"
        >
          类型化 Rust 命令
        </text>
        <text
          x="430"
          y="180"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="9.5"
          fill="#C5663B"
          opacity="0.5"
        >
          安全边界
        </text>
        <text
          x="430"
          y="198"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="9.5"
          fill="#C5663B"
          opacity="0.5"
        >
          前端零文件系统/网络访问
        </text>

        <line
          x1="260"
          y1="160"
          x2="316"
          y2="160"
          stroke="#C5663B"
          stroke-width="1.2"
          marker-end="url(#arr1)"
        />
        <!-- Flowing dot: Frontend → IPC -->
        <circle r="2.5" fill="#C5663B" opacity="0.9">
          <animate
            attributeName="cx"
            from="260"
            to="316"
            dur="1.8s"
            repeatCount="indefinite"
          />
          <animate
            attributeName="cy"
            from="160"
            to="160"
            dur="1.8s"
            repeatCount="indefinite"
          />
          <animate
            attributeName="opacity"
            values="0;0.9;0.9;0"
            keyTimes="0;0.15;0.85;1"
            dur="1.8s"
            repeatCount="indefinite"
          />
        </circle>
        <circle r="2.5" fill="#C5663B" opacity="0.9">
          <animate
            attributeName="cx"
            from="260"
            to="316"
            dur="1.8s"
            begin="0.6s"
            repeatCount="indefinite"
          />
          <animate
            attributeName="cy"
            from="160"
            to="160"
            dur="1.8s"
            begin="0.6s"
            repeatCount="indefinite"
          />
          <animate
            attributeName="opacity"
            values="0;0.9;0.9;0"
            keyTimes="0;0.15;0.85;1"
            dur="1.8s"
            begin="0.6s"
            repeatCount="indefinite"
          />
        </circle>

        <line
          x1="544"
          y1="160"
          x2="600"
          y2="160"
          stroke="#C5663B"
          stroke-width="1.2"
          marker-end="url(#arr2)"
        />
        <!-- Flowing dot: IPC → Backend -->
        <circle r="2.5" fill="#C5663B" opacity="0.9">
          <animate
            attributeName="cx"
            from="544"
            to="600"
            dur="1.8s"
            begin="0.3s"
            repeatCount="indefinite"
          />
          <animate
            attributeName="cy"
            from="160"
            to="160"
            dur="1.8s"
            begin="0.3s"
            repeatCount="indefinite"
          />
          <animate
            attributeName="opacity"
            values="0;0.9;0.9;0"
            keyTimes="0;0.15;0.85;1"
            dur="1.8s"
            begin="0.3s"
            repeatCount="indefinite"
          />
        </circle>
        <circle r="2.5" fill="#C5663B" opacity="0.9">
          <animate
            attributeName="cx"
            from="544"
            to="600"
            dur="1.8s"
            begin="0.9s"
            repeatCount="indefinite"
          />
          <animate
            attributeName="cy"
            from="160"
            to="160"
            dur="1.8s"
            begin="0.9s"
            repeatCount="indefinite"
          />
          <animate
            attributeName="opacity"
            values="0;0.9;0.9;0"
            keyTimes="0;0.15;0.85;1"
            dur="1.8s"
            begin="0.9s"
            repeatCount="indefinite"
          />
        </circle>

        <rect
          x="600"
          y="20"
          width="230"
          height="280"
          rx="14"
          fill="#fff"
          stroke="#E2E0D9"
          stroke-width="1.5"
        />
        <text
          x="715"
          y="56"
          text-anchor="middle"
          font-family="ui-serif,Georgia,serif"
          font-size="16"
          font-weight="500"
          fill="#121215"
        >
          Backend
        </text>
        <text
          x="715"
          y="80"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="10"
          fill="#7B7972"
        >
          Tauri v2 · Rust
        </text>

        <rect
          x="620"
          y="100"
          width="190"
          height="32"
          rx="8"
          fill="#EDEBE5"
          stroke="#E2E0D9"
          stroke-width="0.8"
        />
        <text
          x="715"
          y="121"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="10"
          fill="#3D3C38"
        >
          CliService
        </text>
        <rect
          x="620"
          y="140"
          width="190"
          height="32"
          rx="8"
          fill="#EDEBE5"
          stroke="#E2E0D9"
          stroke-width="0.8"
        />
        <text
          x="715"
          y="161"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="10"
          fill="#3D3C38"
        >
          Consistency Checker
        </text>

        <rect
          x="620"
          y="180"
          width="90"
          height="36"
          rx="8"
          fill="#EDEBE5"
          stroke="#CECBC2"
          stroke-width="0.8"
        />
        <text
          x="665"
          y="203"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="9.5"
          fill="#7B7972"
        >
          GitHub API
        </text>
        <rect
          x="720"
          y="180"
          width="90"
          height="36"
          rx="8"
          fill="#EDEBE5"
          stroke="#CECBC2"
          stroke-width="0.8"
        />
        <text
          x="765"
          y="203"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="9.5"
          fill="#7B7972"
        >
          skills.sh API
        </text>

        <text
          x="715"
          y="246"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="9.5"
          fill="#7B7972"
        >
          notify crate · Symlink
        </text>
        <text
          x="715"
          y="264"
          text-anchor="middle"
          font-family="ui-monospace,monospace"
          font-size="9.5"
          fill="#7B7972"
        >
          SHA-256 · AtomicBool · RwLock
        </text>

        <defs>
          <marker
            id="arr1"
            markerWidth="8"
            markerHeight="8"
            refX="7"
            refY="4"
            orient="auto"
          >
            <path d="M0,0 L8,4 L0,8 L2,4 Z" fill="#C5663B" />
          </marker>
          <marker
            id="arr2"
            markerWidth="8"
            markerHeight="8"
            refX="7"
            refY="4"
            orient="auto"
          >
            <path d="M0,0 L8,4 L0,8 L2,4 Z" fill="#C5663B" />
          </marker>
        </defs>
      </svg>
    </div>
  </div>
</section>
