---
import '../styles/global.css';
import { useTranslations, langPath, type Lang } from '../i18n/ui';
import { basePath } from '../lib/paths';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import InstallModal from '../components/InstallModal.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const canonical = new URL(langPath(lang), Astro.site);
const enUrl = new URL(langPath('en'), Astro.site);
const zhUrl = new URL(langPath('zh'), Astro.site);
const imageUrl = new URL(basePath + 'screenshots/screenshot-1.webp', Astro.site);
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline define:vars={{ basePath }}>
      // Keep old language links and root-language preferences working before paint.
      const url = new URL(location.href);
      const requested = url.searchParams.get('lang');
      let preferred = requested === 'zh' || requested === 'en' ? requested : null;
      const isRoot = url.pathname.replace(/\/$/, '') === basePath.replace(/\/$/, '');
      if (!preferred && isRoot) {
        let saved;
        try { saved = localStorage.getItem('lang'); } catch (_) {}
        preferred = saved === 'zh' || saved === 'en' ? saved :
          (navigator.languages || [navigator.language]).some(l => l.toLowerCase().startsWith('zh')) ? 'zh' : 'en';
      }
      if (preferred) {
        const target = basePath + (preferred === 'zh' ? 'zh/' : '');
        if (url.pathname !== target) {
          url.pathname = target;
          location.replace(url.href);
        }
      }
    </script>
    <title>{t('meta-title')}</title>
    <meta name="description" content={t('meta-description')} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t('meta-title')} />
    <meta property="og:description" content={t('meta-description')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={basePath + 'favicon.png'} />
    <link href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/style.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-mono/style.css" rel="stylesheet" />
  </head>
  <body>
    <Nav />
    <slot />
    <Footer />
    <InstallModal lang={lang} />
    <script>
      import '../scripts/page.js';
    </script>
  </body>
</html>
