{
  "name": "skill-zoo-workspace",
  "version": "0.3.60",
  "description": "Local GUI tool for managing Agent Skills",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "tauri": "bunx tauri",
    "typecheck": "bunx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny=correctness --deny=suspicious --deny=perf src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml --features test-helpers -- -D warnings",
    "format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rs:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test:rs": "cargo test --manifest-path src-tauri/Cargo.toml --features test-helpers",
    "cli:build": "cd packages/cli && bun run build",
    "cli:test": "cd packages/cli && bun run test",
    "cli:typecheck": "cd packages/cli && bun run typecheck",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@dnd-kit/react": "0.5.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.104.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.5.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.5.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.61.0",
    "modern-screenshot": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
